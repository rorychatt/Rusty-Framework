<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\csharp\Rusty.Framework.CSharp\Rusty.Framework.CSharp.csproj" />
  </ItemGroup>

  <Target Name="TranspileToRust" AfterTargets="Build">
    <Message Importance="High" Text="--- RUSTY: Transpiling to Native Rust ---" />
    <Exec Command="cargo run" WorkingDirectory="../.." />
  </Target>
</Project>
